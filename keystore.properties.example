# Copy to keystore.properties (gitignored) to produce a signed release build.
#
# Generate the keystore first, keep it somewhere safe, and never commit it:
#
#   keytool -genkeypair -v \
#     -keystore ~/zlt-companion-release.jks \
#     -alias zlt-companion \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the project root, so an absolute path is
# usually what you want here.
#
# Losing this keystore means you can never update the app on Play again, so
# back it up somewhere other than this machine.

storeFile=/absolute/path/to/zlt-companion-release.jks
storePassword=
keyAlias=zlt-companion
keyPassword=
