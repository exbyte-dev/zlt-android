<?xml version="1.0" encoding="utf-8"?>
<!-- The only thing the app stores is the router address and its password. That
     password is sealed to an Android Keystore key which does not leave the
     device, so a backup copy of the ciphertext would be undecryptable anyway.
     Excluding everything keeps it off cloud backup and out of device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
